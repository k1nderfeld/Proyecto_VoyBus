# Copia este archivo como .env solo si necesitas cambiar la URL de la API.
#
# Por defecto la app usa la IP del PC que ejecuta "npx expo start" y el puerto 3000,
# así que en la misma red Wi-Fi no hace falta configurar nada.
#
# Ejemplos:
#   Backend en otro equipo:     EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api
#   Emulador de Android:        EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
EXPO_PUBLIC_API_URL=
