# Copia este archivo como .env y completa los valores. El archivo .env no se sube al repositorio.

# Puerto del servidor. La app móvil usa el 3000 por defecto.
PORT=3000

# Clave para firmar las sesiones. Si se deja vacía, se genera una al iniciar y las sesiones
# se pierden cada vez que el servidor se reinicia. Usa un texto largo y aleatorio.
JWT_SECRET=
# Duración de la sesión (formato de jsonwebtoken: 1d, 12h, 30m…).
JWT_EXPIRES_IN=1d

# Nombre de la base de datos SQLite (se crea en src/database/<nombre>.sqlite).
DATABASE_NAME=voybus

# Contraseña de las cuentas demo que crea "npm run seed" (por defecto: Demo123!).
SEED_DEMO_PASSWORD=

# Entorno. En "production" no se muestran códigos en la consola y el SMS simulado queda desactivado.
NODE_ENV=development

# IDs de cliente OAuth de Google Cloud (web, Android, iOS) separados por coma, para POST /api/auth/google.
# Si se deja vacío, el inicio de sesión con Google responde que no está disponible.
GOOGLE_CLIENT_IDS=

# Correo saliente (verificar la cuenta, recuperar contraseña y cambiar correo). Si no se configura,
# el servidor funciona igual pero no envía correos: en desarrollo, el código para verificar la cuenta
# aparece en la consola del servidor. Los SMS siempre son simulados (también aparecen en la consola).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Enlaces que van en los correos. Para que abran la app en Expo Go, usa la IP del PC:
#   exp://192.168.1.10:8081/--/reset-password
#   exp://192.168.1.10:8081/--/confirm-email
# Si no se configuran, la app permite pegar el enlace o el código del correo a mano.
PASSWORD_RESET_URL=
EMAIL_CHANGE_URL=
